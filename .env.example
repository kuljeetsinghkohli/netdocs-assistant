# ============================================================
# NetDocs Assistant — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# --- Embedding backend ---
# Options: "openai" | "sentence-transformers"
NETDOCS_EMBED_BACKEND=sentence-transformers

# Sentence-transformers model (used when EMBED_BACKEND=sentence-transformers)
NETDOCS_EMBED_MODEL=BAAI/bge-base-en-v1.5

# OpenAI API key (used when EMBED_BACKEND=openai OR LLM_PROVIDER=openai)
# This is also read as OPENAI_API_KEY (no NETDOCS_ prefix) — standard convention.
OPENAI_API_KEY=sk-...

# Google Gemini API key (used when LLM_PROVIDER=gemini).
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI embedding model (only used when EMBED_BACKEND=openai)
NETDOCS_OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Vector store ---
NETDOCS_CHROMA_PATH=chroma_db
NETDOCS_CHROMA_COLLECTION=netdocs

# --- Ingestion ---
NETDOCS_DATA_DIR=data/raw
NETDOCS_CHUNK_SIZE_PROSE=400
NETDOCS_CHUNK_OVERLAP_PROSE=50
NETDOCS_CHUNK_SIZE_RUNBOOK=300
NETDOCS_CHUNK_SIZE_TICKET=250
NETDOCS_CHUNK_SIZE_CONFIG=600

# --- LLM provider ---
# Options: "openai" | "ollama" | "gemini" | "extractive" | "fake"
#
# Auto-selection when NETDOCS_LLM_PROVIDER=openai but openai is not installed/keyed:
#   - If GEMINI_API_KEY is set   → uses gemini automatically
#   - Otherwise                  → uses extractive (no key, returns retrieved passages)
#
# "extractive" needs no API key and works offline — good for smoke-testing.
# "fake"       is a deterministic stub for automated tests.
NETDOCS_LLM_PROVIDER=openai

# Model name passed to the LLM provider.
# OpenAI examples : gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Gemini examples : gemini-3.6-flash, gemini-2.5-flash  (set via GEMINI_MODEL below)
# Ollama examples : llama3, mistral, phi3
NETDOCS_LLM_MODEL=gpt-4o-mini

# Gemini-specific model override.  Takes priority over NETDOCS_LLM_MODEL when
# the Gemini provider is active.  Defaults to gemini-3.6-flash.
# Use a non-thinking model here to prevent reasoning tokens leaking into answers.
# GEMINI_MODEL=gemini-3.6-flash

# Ordered fallback list for the Gemini provider (comma-separated, no spaces).
# When the primary model (GEMINI_MODEL) hits a daily quota 429, a retired-model
# 404, or an INVALID_ARGUMENT 400, the client works through this list in order.
# A failed model is remembered for the process lifetime and skipped on future
# requests.  When all models fail the answer degrades to extractive (no 500).
# Default: gemini-3.6-flash,gemini-3-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3-flash

# Temperature (0 = deterministic, higher = more creative)
NETDOCS_LLM_TEMPERATURE=0.0

# Maximum tokens in the completion
NETDOCS_LLM_MAX_TOKENS=1024

# Base URL for Ollama or any OpenAI-compatible local server.
# Only used when NETDOCS_LLM_PROVIDER=ollama.
NETDOCS_LLM_BASE_URL=http://localhost:11434/v1

# --- Retrieval ---
# Final number of chunks passed to the LLM
NETDOCS_RETRIEVAL_TOP_K=5

# Candidates fetched from each retriever before reranking
NETDOCS_RETRIEVAL_CANDIDATE_K=20

# Minimum reranker score to answer (0–∞ logit scale).
# Answers are refused when all results are below this threshold.
NETDOCS_RETRIEVAL_CONFIDENCE_THRESHOLD=0.10

# BM25 parameters
NETDOCS_BM25_K1=1.5
NETDOCS_BM25_B=0.75

# RRF constant (higher = less weight on top-ranked docs)
NETDOCS_RRF_K=60

# --- API server ---
NETDOCS_API_HOST=0.0.0.0
NETDOCS_API_PORT=8000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
NETDOCS_LOG_LEVEL=INFO
