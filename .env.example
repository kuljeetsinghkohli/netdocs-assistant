# ============================================================
# NetDocs Assistant — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# --- Embedding backend ---
# Options: "openai" | "sentence-transformers"
NETDOCS_EMBED_BACKEND=sentence-transformers

# Sentence-transformers model (used when EMBED_BACKEND=sentence-transformers)
NETDOCS_EMBED_MODEL=BAAI/bge-base-en-v1.5

# OpenAI API key (only required when EMBED_BACKEND=openai)
OPENAI_API_KEY=sk-...

# OpenAI embedding model (only used when EMBED_BACKEND=openai)
NETDOCS_OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Vector store ---
# Path to ChromaDB persistent storage (relative to project root)
NETDOCS_CHROMA_PATH=chroma_db

# ChromaDB collection name
NETDOCS_CHROMA_COLLECTION=netdocs

# --- Ingestion ---
# Root directory for raw documents
NETDOCS_DATA_DIR=data/raw

# Chunking token targets per doc type
NETDOCS_CHUNK_SIZE_PROSE=400
NETDOCS_CHUNK_OVERLAP_PROSE=50
NETDOCS_CHUNK_SIZE_RUNBOOK=300
NETDOCS_CHUNK_SIZE_TICKET=250
# Config blocks are not split further; these are max-size guards
NETDOCS_CHUNK_SIZE_CONFIG=600

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
NETDOCS_LOG_LEVEL=INFO
